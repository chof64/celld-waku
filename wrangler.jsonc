{
  "name": "celld-waku",
  "main": "./dist/celld/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/RSC/*"
    ]
  }
}
