{
  "name": "celld-waku",
  "main": "./src/waku.server.tsx",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/RSC/*"
    ]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ]
}
